# Copy to a protected per-environment file; never commit the filled copy.
# DB_PASSWORD: 64 lowercase hexadecimal characters, generated with openssl rand -hex 32.
DB_PASSWORD=YOUR_64_CHARACTER_HEX_PASSWORD
# APP_IMAGE: published immutable GHCR image with a full 40-character commit SHA.
APP_IMAGE=ghcr.io/sprobe-dan/production-cicd-lab:YOUR_FULL_40_CHARACTER_SHA
# ENVIRONMENT: unique label used by generic container names (for example, recovery).
ENVIRONMENT=YOUR_ENVIRONMENT
# APP_PORT: unique, loopback-only host port for this environment.
APP_PORT=YOUR_APP_PORT
